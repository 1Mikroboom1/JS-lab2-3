{
  "info": {
    "name": "Case 2 — Equipment Maintenance API",
    "description": "Обязательная часть кейса 2. Коллекция покрывает все обязательные endpoint'ы и негативные сценарии.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "equipmentId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "serialNumber",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "pm.test('data structure',()=>pm.expect(pm.response.json().data).to.have.property('status','ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "POST create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/equipment",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test Turbine\",\"type\":\"turbine\",\"serialNumber\":\"{{serialNumber}}\",\"location\":{\"lat\":56.3269,\"lon\":44.0059},\"status\":\"operational\",\"installedAt\":\"2024-01-01T00:00:00.000Z\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('serialNumber','TEST-'+Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201',()=>pm.response.to.have.status(201));",
                  "pm.test('data structure',()=>pm.expect(pm.response.json().data).to.have.property('id'));",
                  "pm.test('Location header',()=>pm.expect(pm.response.headers.has('Location')).to.be.true);",
                  "pm.environment.set('equipmentId',pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET list with filter/sort/pagination",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment?status=operational&type=turbine&page=1&limit=10&sort=name&order=asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "pm.test('data/meta structure',()=>{const b=pm.response.json();pm.expect(b.data).to.be.an('array');pm.expect(b.meta).to.have.all.keys('total','page','limit');});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "pm.test('data has id',()=>pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('equipmentId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"maintenance\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "pm.test('status changed',()=>pm.expect(pm.response.json().data.status).to.eql('maintenance'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET nested requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/requests?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "pm.test('data/meta structure',()=>{const b=pm.response.json();pm.expect(b.data).to.be.an('array');pm.expect(b.meta).to.have.all.keys('total','page','limit');});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET weather",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 or 503',()=>pm.expect([200,503]).to.include(pm.response.code));",
                  "pm.test('error or weather structure',()=>{const b=pm.response.json();if(pm.response.code===200)pm.expect(b.data).to.have.property('suitableForOutdoorWork');else pm.expect(b.error).to.have.property('requestId');});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST duplicate serial 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/equipment",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Duplicate\",\"type\":\"sensor\",\"serialNumber\":\"{{serialNumber}}\",\"location\":{\"lat\":56,\"lon\":44},\"status\":\"operational\",\"installedAt\":\"2024-01-01T00:00:00.000Z\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409',()=>pm.response.to.have.status(409));",
                  "pm.test('error structure',()=>pm.expect(pm.response.json().error).to.have.all.keys('code','message','details','requestId'));"
                ]
              }
            }
          ]
        }
      ]
